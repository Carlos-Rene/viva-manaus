# Local Ollama endpoint and an image-capable model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# Optional: your account's ngrok static domain, as a hostname or HTTPS origin.
# The launcher discovers and allows the exact public URL for temporary domains too.
# NGROK_DOMAIN=your-assigned-domain.ngrok-free.app
#
# Optional: additional exact HTTPS origins for protected operations. Never use a wildcard.
# ALLOWED_ORIGINS=https://another-exact-origin.example

# Required for developer sign-in. Generate both values with:
#   node scripts/generate-dev-auth.mjs
# Keep the generated values private and set them in the server environment only.
VIVA_DEV_PASSWORD_HASH=
VIVA_SESSION_SECRET=

# Optional locally; required in production for an authenticated HTTPS proxy.
# OLLAMA_API_TOKEN=replace_with_your_server_only_token

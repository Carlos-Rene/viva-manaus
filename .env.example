# Local Ollama endpoint and an image-capable model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# Required for the public ngrok demo. Use the exact HTTPS origin assigned to your account.
# Separate multiple origins with commas; do not use a wildcard.
# ALLOWED_ORIGINS=https://your-assigned-name.ngrok-free.app

# Optional: comma-separated developer email allowlist for catalog publishing.
# VIVA_DEV_EMAILS=

# Optional locally; required in production for an authenticated HTTPS proxy.
# OLLAMA_API_TOKEN=replace_with_your_server_only_token
